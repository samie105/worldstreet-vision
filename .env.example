# Vision (.env.local) — streaming app at vision.worldstreetgold.com in production.
# Clerk identity is shared with other Worldstreet subdomains (satellite); this file is Vision-only.
# Do not commit real secrets.

# ── Clerk (satellite: sign-in UX lives on www; Vision hosts /login for dev) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── MongoDB (org cluster; Vision uses its own Mongoose models / collections) ──
MONGODB_URI=
MONGODB_DB_NAME=user-account

# ── Cloudflare ────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=
CLOUDFLARE_STREAM_DELIVERY_HOST=videodelivery.net

# R2 / RealtimeKit (optional unless you upload via R2 or use RealtimeKit)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
CLOUDFLARE_REALTIME_ORG_ID=
CLOUDFLARE_REALTIME_API_KEY=
CLOUDFLARE_REALTIME_APP_ID=

# Cloudinary (optional — uploads / asset pipeline if enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_URL=

# ── Ably (watch-together) ─────────────────────────────────────────────────
ABLY_API_KEY=
NEXT_PUBLIC_ABLY_KEY=
NEXT_PUBLIC_ABLY_CLIENT_NAME=worldstreet-vision

# ── App ───────────────────────────────────────────────────────────────────
# Production: https://vision.worldstreetgold.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_URL=
ADMIN_EMAILS=
SENTRY_DSN=

# Email / OpenAI (optional — notifications or tooling if wired)
RESEND_API_KEY=
EMAIL_FROM=
OPENAI_API_KEY=

# ── Dev-only auth bypass (Vision / Playwright; ignored when NODE_ENV=production)
DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
